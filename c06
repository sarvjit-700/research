static std::string trim_whitespace(const std::string &literal)
{
	if (literal.length() == 1)
		return literal;
    size_t start = literal.find_first_not_of(" \t\n\r\f\v");
	std::string s; 
    if (start == std::string::npos) 
        return "";
    size_t end = literal.find_last_not_of(" \t\n\r\f\v"); 
    s = literal.substr(start, end - start + 1);
	return s;
}

void ScalarConverter::convert(const std::string &literal)
{
	std::string normalized = trim_whitespace(literal);
	e_type var = check_type(normalized);
	char *endptr = NULL;
	switch (var)
	{
		case (EXCEPTION):
		{
			print_exception(normalized);
			break;
		}
		case (INT):
		{
			long value = strtol(normalized.c_str(), &endptr, 10);
			print_integer(value);
			break;
		}
		case (CHAR):
		{
			char value = normalized[0];
			print_char(value);
			break;
		}
		case (FLOAT):
		{
			float value = static_cast<float>(strtod(normalized.c_str(), &endptr));
			print_float(value);
			break;
		}
		case (DOUBLE):
		{
			double value = strtod(normalized.c_str(), &endptr);
			print_double(value);
			break;
		}
		case (WRONG_TYPE):
			std::cout << "Please provide allowed literal" << std::endl;
			break;
		default:
			break;
	}
}

