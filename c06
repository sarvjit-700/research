#include "Base.hpp"
#include "A.hpp"
#include "B.hpp"
#include "C.hpp"
#include <exception>

void identify(Base* p)
{
	if (dynamic_cast<A*>(p))
		std::cout << "Our type is A" << std::endl;
	else if (dynamic_cast<B*>(p))
		std::cout << "Our type is B" << std::endl;
	else if (dynamic_cast<C*>(p))
		std::cout << "Our type is C" << std::endl;
	else
		std::cout << "It should not had happened, but every cast returned NULL, therefore it's an unknown type" << std::endl;
}

void identify(Base &p)
{
	try
	{
		static_cast<void>(dynamic_cast<A&>(p));
		std::cout << "Our type is A" << std::endl;
		return;
	}
	catch(const std::exception&)
	{}

	try 
	{
		(void)dynamic_cast<B&>(p);
		std::cout << "Our type is B" << std::endl;
		return;
	}
	catch(const std::exception&){}

	try
	{
		(void)dynamic_cast<C&>(p);
		std::cout << "Our type is C" << std::endl;
		return;
	}
	catch(const std::exception&){}

	std::cout << "It should not had happened, but every cast resulted in error, therefore it's an unknown type";
	
}

