#include "ScalarConverter.hpp"

static void apply_precision(double value)
{
    double dummy;
    if (std::modf(value, &dummy) == 0.0)
        std::cout << std::fixed << std::setprecision(1);
    else
        std::cout << std::setprecision(6);
}

e_type check_type(const std::string &literal)
{
	if (literal.empty())
        return WRONG_TYPE;
		
	std::string pseudo_literals[] = {"-inff", "+inff", "nanf", "-inf", "+inf", "nan"};
    for (int i = 0; i < 6; i++) {
        if (literal == pseudo_literals[i])
            return EXCEPTION;
    }
    if (literal.length() == 1 && !isdigit(literal[0]))
        return CHAR;
    char *endptr = NULL;
    errno = 0;
	strtod(literal.c_str(), &endptr);
	if (endptr != literal.c_str())
    {
        if (*endptr == '\0' && literal.find('.') != std::string::npos)
            return DOUBLE;
        else if (*endptr == 'f' && *(endptr + 1) == '\0' && literal.find('.') != std::string::npos)
            return FLOAT;
    }
    errno = 0;
    endptr = NULL;
    strtol(literal.c_str(), &endptr, 10);
    if (*endptr == '\0' && endptr != literal.c_str())
    {
        if (errno == ERANGE)
            return DOUBLE;
        return INT;
    }
    return WRONG_TYPE;
}

void print_exception(const std::string &literal)
{
    std::cout << "char: impossible" << std::endl;
    std::cout << "int: impossible" << std::endl;

    if (literal == "nan" || literal == "nanf")
    {
        std::cout << "float: nanf" << std::endl;
        std::cout << "double: nan" << std::endl;
    }
    else if (literal == "+inf" || literal == "+inff")
    {
        std::cout << "float: +inff" << std::endl;
        std::cout << "double: +inf" << std::endl;
    }
    else if (literal == "-inf" || literal == "-inff")
    {
        std::cout << "float: -inff" << std::endl;
        std::cout << "double: -inf" << std::endl;
    }
}

void print_char(char value)
{
	if (!std::isprint(static_cast<char>(value)))
		std::cout << "char: Non-printable" << std::endl;
	else
		std::cout << "char: '" << value << "'" << std::endl;
	std::cout << "int: " << static_cast<int>(value) << std::endl;
	std::cout << std::fixed << std::setprecision(1);
	std::cout << "float: " << static_cast<float>(value) << "f" << std::endl;
	std::cout << "double: " << static_cast<double>(value) << std::endl;
}

void print_integer(long value)
{
	if (value > INT_MAX || value < INT_MIN)
	{
		std::cout << "char: impossible" << std::endl;
		std::cout << "int: overflows" << std::endl;
	}
	else
	{
		if (value < 0 || value > 127)
			std::cout << "char: impossible" << std::endl;
		else if (!std::isprint(value))
			std::cout << "char: Non-printable" << std::endl;
		else
			std::cout << "char: '" << static_cast<char>(value) << "'" << std::endl;
		std::cout << "int: " << static_cast<int>(value) << std::endl;
	}
	apply_precision(value);
	std::cout << "float: " << static_cast<float>(value) << "f" << std::endl;
	std::cout << "double: " << static_cast<double>(value) << std::endl;
}

void print_float(float value)
{	
	if (value < 0 || value > 127)
		std::cout << "char: impossible" << std::endl;
	else if (!std::isprint(static_cast<char>(value)))
		std::cout << "char: Non-printable" << std::endl;
	else
		std::cout << "char: '" << static_cast<char>(value) << "'" << std::endl;
	if (static_cast<long>(value) > INT_MAX || static_cast<long>(value) < INT_MIN)
		std::cout << "int: overflows" << std::endl;
	else
		std::cout << "int: " << static_cast<int>(value) << std::endl;
	apply_precision(value);
	std::cout << "float: " << value << "f" << std::endl;
	std::cout << "double: " << static_cast<double>(value) << std::endl;
}

void print_double(double value)
{	
	if (value < 0 || value > 127)
		std::cout << "char: impossible" << std::endl;
	else if (!std::isprint(static_cast<char>(value)))
		std::cout << "char: Non-printable" << std::endl;
	else
		std::cout << "char: '" << static_cast<char>(value) << "'" << std::endl;
	if (static_cast<long>(value) > INT_MAX || static_cast<long>(value) < INT_MIN)
		std::cout << "int: overflows" << std::endl;
	else
		std::cout << "int: " << static_cast<int>(value) << std::endl;
	apply_precision(value);
	std::cout << "float: " << static_cast<float>(value) << "f" << std::endl;
	std::cout << "double: " << value << std::endl;
}


